<!-- ABOUTME: Additional Info.plist settings for App Store compliance -->
<!-- ABOUTME: Declares encryption usage for export compliance -->
<plist version="1.0">
<dict>
    <!-- Encryption compliance: PingZilla Next does not use non-exempt encryption -->
    <!-- HTTPS/TLS connections are exempt from export restrictions -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>PingZilla uses access to Wi-Fi network information to show the BSSID of the access point your Mac is currently using. Your geographic location is not collected.</string>
</dict>
</plist>
